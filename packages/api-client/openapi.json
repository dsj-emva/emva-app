{
  "components": {
    "schemas": {
      "Advertiser": {
        "properties": {
          "data_source": {
            "$ref": "#/components/schemas/DataSource"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "leads_file": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FileProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "mapping_confirmed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the mapping was confirmed; from then on the files cannot be replaced",
            "title": "Mapping Confirmed At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "review_available": {
            "description": "True once both files are uploaded",
            "title": "Review Available",
            "type": "boolean"
          },
          "stage_history_file": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FileProfile"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "data_source",
          "leads_file",
          "stage_history_file",
          "review_available",
          "mapping_confirmed_at"
        ],
        "title": "Advertiser",
        "type": "object"
      },
      "Column": {
        "properties": {
          "examples": {
            "description": "The column's first few distinct non-empty values",
            "items": {
              "type": "string"
            },
            "title": "Examples",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "examples"
        ],
        "title": "Column",
        "type": "object"
      },
      "ColumnKind": {
        "description": "How an input column is read: as a number, or as one of a set of categories.",
        "enum": [
          "number",
          "category"
        ],
        "title": "ColumnKind",
        "type": "string"
      },
      "Country": {
        "description": "The countries a phone written without an international prefix can be read as from.",
        "enum": [
          "GB",
          "IE"
        ],
        "title": "Country",
        "type": "string"
      },
      "CountryChoice": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/Country"
          }
        },
        "required": [
          "value",
          "name"
        ],
        "title": "CountryChoice",
        "type": "object"
      },
      "CrmStage": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "row_count": {
            "title": "Row Count",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "row_count"
        ],
        "title": "CrmStage",
        "type": "object"
      },
      "DataSource": {
        "description": "Where an advertiser's data comes from; every result is labelled with it.",
        "enum": [
          "hand_made_test",
          "simulated",
          "public",
          "private"
        ],
        "title": "DataSource",
        "type": "string"
      },
      "DateOrder": {
        "enum": [
          "year_month_day",
          "day_month_year",
          "month_day_year"
        ],
        "title": "DateOrder",
        "type": "string"
      },
      "DateOrderChoice": {
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/DateOrder"
          }
        },
        "required": [
          "value",
          "label"
        ],
        "title": "DateOrderChoice",
        "type": "object"
      },
      "FileKind": {
        "enum": [
          "leads",
          "stage-history"
        ],
        "title": "FileKind",
        "type": "string"
      },
      "FileProfile": {
        "properties": {
          "column_names": {
            "items": {
              "type": "string"
            },
            "title": "Column Names",
            "type": "array"
          },
          "file_name": {
            "title": "File Name",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/FileKind"
          },
          "raw_kept": {
            "description": "Whether the raw file is still in storage; false once formatted and deleted",
            "title": "Raw Kept",
            "type": "boolean"
          },
          "row_count": {
            "title": "Row Count",
            "type": "integer"
          },
          "uploaded_at": {
            "format": "date-time",
            "title": "Uploaded At",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "file_name",
          "uploaded_at",
          "row_count",
          "column_names",
          "raw_kept"
        ],
        "title": "FileProfile",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "InputKindChoice": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ColumnKind"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "label"
        ],
        "title": "InputKindChoice",
        "type": "object"
      },
      "LeadsColumns": {
        "description": "Which leads-file column holds what. Every column not marked here is dropped.",
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The lead's email, to be scrambled",
            "title": "Email"
          },
          "inputs": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ColumnKind"
            },
            "description": "The inputs to the score, each read as its kind",
            "title": "Inputs",
            "type": "object"
          },
          "lead_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lead Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The lead's name, to be removed",
            "title": "Name"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The lead's phone, to be scrambled",
            "title": "Phone"
          },
          "submitted_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the lead was submitted",
            "title": "Submitted At"
          }
        },
        "title": "LeadsColumns",
        "type": "object"
      },
      "LeadsRole": {
        "description": "What a leads-file column can hold besides an input; each is a field of LeadsColumns.",
        "enum": [
          "lead_id",
          "submitted_at",
          "name",
          "email",
          "phone"
        ],
        "title": "LeadsRole",
        "type": "string"
      },
      "LeadsRoleChoice": {
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/LeadsRole"
          }
        },
        "required": [
          "role",
          "label"
        ],
        "title": "LeadsRoleChoice",
        "type": "object"
      },
      "Mapping": {
        "properties": {
          "crm_stages": {
            "additionalProperties": {
              "$ref": "#/components/schemas/StageOrLost"
            },
            "description": "Where each CRM stage name sits: a Stage, or Lost",
            "title": "Crm Stages",
            "type": "object"
          },
          "date_order": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DateOrder"
              },
              {
                "type": "null"
              }
            ],
            "description": "The order both files write dates in"
          },
          "default_country": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Country"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where a phone written without an international prefix is from"
          },
          "leads": {
            "$ref": "#/components/schemas/LeadsColumns",
            "default": {
              "inputs": {}
            }
          },
          "stage_history": {
            "$ref": "#/components/schemas/StageHistoryColumns",
            "default": {}
          },
          "time_zone": {
            "default": "UTC",
            "description": "The zone of every time written without one",
            "title": "Time Zone",
            "type": "string"
          },
          "typical_deal_size": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Typical Deal Size"
          }
        },
        "title": "Mapping",
        "type": "object"
      },
      "MappingReview": {
        "properties": {
          "confirmed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When a person confirmed it; null in draft",
            "title": "Confirmed At"
          },
          "countries": {
            "description": "The countries a phone without an international prefix can be from",
            "items": {
              "$ref": "#/components/schemas/CountryChoice"
            },
            "title": "Countries",
            "type": "array"
          },
          "crm_stages": {
            "description": "Every CRM stage name in the column marked as the CRM stage, most used first",
            "items": {
              "$ref": "#/components/schemas/CrmStage"
            },
            "title": "Crm Stages",
            "type": "array"
          },
          "date_orders": {
            "description": "The orders dates can be written in",
            "items": {
              "$ref": "#/components/schemas/DateOrderChoice"
            },
            "title": "Date Orders",
            "type": "array"
          },
          "formatted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When its data was formatted",
            "title": "Formatted At"
          },
          "formatting": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Summary"
              },
              {
                "type": "null"
              }
            ],
            "description": "What formatting made of the files"
          },
          "input_kinds": {
            "description": "How an input column can be read",
            "items": {
              "$ref": "#/components/schemas/InputKindChoice"
            },
            "title": "Input Kinds",
            "type": "array"
          },
          "leads_roles": {
            "description": "What a leads-file column can hold",
            "items": {
              "$ref": "#/components/schemas/LeadsRoleChoice"
            },
            "title": "Leads Roles",
            "type": "array"
          },
          "mapping": {
            "$ref": "#/components/schemas/Mapping"
          },
          "problems": {
            "description": "Why it cannot be confirmed yet; empty once it can",
            "items": {
              "type": "string"
            },
            "title": "Problems",
            "type": "array"
          },
          "stage_history_roles": {
            "description": "What a stage-history column can hold",
            "items": {
              "$ref": "#/components/schemas/StageHistoryRoleChoice"
            },
            "title": "Stage History Roles",
            "type": "array"
          },
          "stages_and_lost": {
            "description": "What a CRM stage can be placed on: the Canonical ladder in order, then Lost",
            "items": {
              "$ref": "#/components/schemas/StageOrLostChoice"
            },
            "title": "Stages And Lost",
            "type": "array"
          },
          "still_to_do": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What confirming still has to do, when it was interrupted; confirming again does it. Null in draft and once confirming is done.",
            "title": "Still To Do"
          }
        },
        "required": [
          "mapping",
          "confirmed_at",
          "formatted_at",
          "formatting",
          "still_to_do",
          "problems",
          "crm_stages",
          "leads_roles",
          "stage_history_roles",
          "input_kinds",
          "stages_and_lost",
          "date_orders",
          "countries"
        ],
        "title": "MappingReview",
        "type": "object"
      },
      "NewAdvertiser": {
        "properties": {
          "data_source": {
            "$ref": "#/components/schemas/DataSource"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "data_source"
        ],
        "title": "NewAdvertiser",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Stage": {
        "description": "A Stage of the Canonical ladder; members are in ladder order.",
        "enum": [
          "submitted",
          "contact_attempted",
          "engaged",
          "qualified",
          "proposal",
          "won"
        ],
        "title": "Stage",
        "type": "string"
      },
      "StageHistoryColumns": {
        "properties": {
          "changed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the change of CRM stage happened",
            "title": "Changed At"
          },
          "crm_stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crm Stage"
          },
          "deal_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deal Value"
          },
          "lead_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lead Id"
          }
        },
        "title": "StageHistoryColumns",
        "type": "object"
      },
      "StageHistoryRole": {
        "description": "What a stage-history column can hold; each is a field of StageHistoryColumns.",
        "enum": [
          "lead_id",
          "crm_stage",
          "changed_at",
          "deal_value"
        ],
        "title": "StageHistoryRole",
        "type": "string"
      },
      "StageHistoryRoleChoice": {
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/StageHistoryRole"
          }
        },
        "required": [
          "role",
          "label"
        ],
        "title": "StageHistoryRoleChoice",
        "type": "object"
      },
      "StageOrLost": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/Stage"
          },
          {
            "const": "lost",
            "type": "string"
          }
        ]
      },
      "StageOrLostChoice": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/StageOrLost"
          }
        },
        "required": [
          "value",
          "name"
        ],
        "title": "StageOrLostChoice",
        "type": "object"
      },
      "Summary": {
        "description": "What the Formatter made of the two files.",
        "properties": {
          "lead_count": {
            "title": "Lead Count",
            "type": "integer"
          },
          "lost": {
            "title": "Lost",
            "type": "integer"
          },
          "neglected": {
            "description": "Neglected leads: never attempted to contact",
            "title": "Neglected",
            "type": "integer"
          },
          "no_outcome_yet": {
            "description": "Leads neither won nor lost yet",
            "title": "No Outcome Yet",
            "type": "integer"
          },
          "unreadable": {
            "items": {
              "$ref": "#/components/schemas/UnreadableRows"
            },
            "title": "Unreadable",
            "type": "array"
          },
          "won": {
            "title": "Won",
            "type": "integer"
          }
        },
        "required": [
          "lead_count",
          "won",
          "lost",
          "no_outcome_yet",
          "neglected",
          "unreadable"
        ],
        "title": "Summary",
        "type": "object"
      },
      "UnreadableRows": {
        "description": "The rows of one file that could not be read for one reason, and so were not kept.",
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "file": {
            "$ref": "#/components/schemas/FileKind"
          },
          "first_rows": {
            "description": "The first 10 of them, by place in the file from 1 below the header",
            "items": {
              "type": "integer"
            },
            "title": "First Rows",
            "type": "array"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "file",
          "reason",
          "count",
          "first_rows"
        ],
        "title": "UnreadableRows",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Emva API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/advertisers": {
      "post": {
        "operationId": "createAdvertiser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewAdvertiser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Advertiser"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Advertiser"
      }
    },
    "/advertisers/{advertiser_id}": {
      "get": {
        "operationId": "getAdvertiser",
        "parameters": [
          {
            "in": "path",
            "name": "advertiser_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Advertiser Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Advertiser"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Advertiser"
      }
    },
    "/advertisers/{advertiser_id}/files/{kind}": {
      "put": {
        "description": "Upload the file, replacing any earlier upload of the same kind.",
        "operationId": "uploadFile",
        "parameters": [
          {
            "in": "path",
            "name": "advertiser_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Advertiser Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FileKind"
            }
          },
          {
            "in": "query",
            "name": "file_name",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "title": "File Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "text/csv": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileProfile"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not a readable CSV file"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Another upload won, or the mapping is confirmed"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Over 20 MB"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not saved"
          }
        },
        "summary": "Upload File"
      }
